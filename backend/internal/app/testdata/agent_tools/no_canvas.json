          },
          "limit": {
            "maximum": 30,
            "minimum": 1,
            "type": "integer"
          },
          "topic": {
            "description": "Get the full text of one item: copy the topic exactly as given in the index",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      }
    },
    "type": "function"
  },
  {
    "function": {
      "description": "Record an approach that actually worked in this run into your own personal memory. Available only when a tool that changes the canvas or generation results actually succeeded in this run. Write the general method; do not restate specific objects. Once recorded, it only takes effect in later sessions after approval in Settings → Agent memory.",
      "name": "remember_lesson",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "category": {
