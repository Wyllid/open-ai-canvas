  {
    "function": {
      "description": "Maintain a multi-step task list consistent with the current user request. items replaces the whole list; update status of finished items from real results; remove cancelled or no-longer-relevant items (pass an empty array if everything is cancelled) and never mark cancelled items as done. The list is shown in the interface and used as later context; it grants no extra authorization. Simple Q\u0026A or single edits do not need a list first.",
      "name": "plan_update",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "description": "Short id, e.g. 1",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "pending",
                    "doing",
                    "done"
                  ],
                  "type": "string"
                },
                "title": {
                  "description": "What this item does",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "status"
              ],
              "type": "object"
            },
            "maxItems": 20,
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    },
    "type": "function"
  },
  {
    "function": {
      "description": "Call only when the creative goal still has an open choice that would materially change the result. Ask once per run: use options for a single choice, or combine several related preferences in fields as one compact editable form with recommended values; rare items such as the model are optional and recommended automatically by default. Do not ask when the user has set the direction, delegated the decision or said \"use the recommendation / just start\"; never treat an unfounded guess as a safe default. This run ends here and continues automatically after the user submits; the server allows at most 2 confirmation rounds.",
      "name": "ask_user",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "allowFreeform": {
            "description": "Whether a note outside the form is allowed (allowed by default)",
            "type": "boolean"
          },
          "fields": {
            "description": "Dynamic form of several related creative parameters; use either this or options",
            "items": {
              "additionalProperties": false,
              "properties": {
                "allowCustom": {
                  "type": "boolean"
                },
                "defaultValue": {
                  "anyOf": [
                    {
                      "description": "Recommended default; optional",
                      "type": "string"
                    },
                    {
                      "items": {
                        "description": "Default option",
                        "type": "string"
                      },
                      "type": "array"
                    }
                  ]
                },
                "id": {
                  "description": "Stable field id, e.g. aspectRatio",
                  "type": "string"
                },
                "options": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "detail": {
                        "description": "Optional description",
                        "type": "string"
                      },
                      "id": {
                        "description": "Stable option id",
                        "type": "string"
                      },
                      "label": {
                        "description": "Option name",
                        "type": "string"
                      },
                      "recommended": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "label"
                    ],
                    "type": "object"
                  },
                  "maxItems": 8,
                  "type": "array"
                },
                "placeholder": {
                  "description": "Input hint",
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "title": {
                  "description": "Field display name",
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "single_select",
                    "multi_select",
                    "segmented",
                    "text",
                    "textarea",
                    "model_picker"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "type"
              ],
              "type": "object"
            },
            "maxItems": 6,
            "minItems": 1,
            "type": "array"
          },
          "maxRounds": {
            "description": "Optional confirmation limit; the server uses its fixed limit",
            "maximum": 2,
            "minimum": 1,
            "type": "integer"
          },
          "options": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "detail": {
                  "description": "Optional: one-sentence note",
                  "type": "string"
                },
                "label": {
                  "description": "Option text",
                  "type": "string"
                }
              },
              "required": [
                "label"
              ],
              "type": "object"
            },
            "maxItems": 6,
            "minItems": 2,
            "type": "array"
          },
          "question": {
            "description": "The topic the user must confirm, in one sentence",
            "type": "string"
          },
          "questionId": {
            "description": "Optional stable question id",
            "type": "string"
          },
          "round": {
            "description": "Optional confirmation round; the server uses the persisted round",
            "maximum": 2,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "question"
        ],
        "type": "object"
      }
    },
    "type": "function"
  },
